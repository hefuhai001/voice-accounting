# MySQL 8.0 配置文件示例
# 适用于生产环境基础配置，可根据实际需求调整

[client]
# 客户端设置
port = 3306
socket = /tmp/mysql.sock
default-character-set = utf8mb4

[mysql]
# MySQL 命令行客户端设置
prompt = "\\u@\\h [\\d]> "
no-auto-rehash
default-character-set = utf8mb4

[mysqld]
# 基础路径设置
basedir = /usr
datadir = /var/lib/mysql
socket = /tmp/mysql.sock
pid-file = /var/run/mysqld/mysqld.pid
log-error = /var/log/mysql/error.log
port = 3306

# 字符集和排序规则
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init-connect = 'SET NAMES utf8mb4'

# 连接设置
max_connections = 500
max_connect_errors = 10000
connect_timeout = 10
wait_timeout = 28800
interactive_timeout = 28800

# 线程与缓存
thread_cache_size = 100
table_open_cache = 4000
table_definition_cache = 2000
query_cache_type = 0          # MySQL 8.0 已废弃 query cache
query_cache_size = 0

# 临时表和排序
tmp_table_size = 64M
max_heap_table_size = 64M
sort_buffer_size = 4M
join_buffer_size = 4M

# InnoDB 核心配置
default_storage_engine = InnoDB
innodb_buffer_pool_size = 1G   # 建议设为物理内存的 50-70%
innodb_log_file_size = 512M
innodb_log_buffer_size = 16M
innodb_flush_log_at_trx_commit = 2    # 0=每秒刷盘,1=每次提交刷盘(最安全),2=每秒刷盘(高性能)
innodb_flush_method = O_DIRECT        # 避免双缓冲
innodb_file_per_table = 1
innodb_autoinc_lock_mode = 2
innodb_lock_wait_timeout = 50
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_io_capacity = 2000
innodb_io_capacity_max = 3000

# 日志相关
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 1

# 二进制日志（必须开启才能使用 GTID 等特性）
server-id = 1
log_bin = /var/log/mysql/mysql-bin.log
binlog_format = ROW
expire_logs_days = 7
max_binlog_size = 1G
binlog_cache_size = 32K
sync_binlog = 1                # 最安全，影响性能可改为 0 或 100

# 错误日志
log_error = /var/log/mysql/error.log
log_warnings = 2

# 安全设置
local_infile = OFF
symbolic-links = 0
skip_name_resolve = 1          # 跳过域名解析，建议开启提高性能
sql_mode = 'STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'

# 时区
default_time_zone = '+8:00'    # 中国时区

# 其他性能优化
max_allowed_packet = 64M
bulk_insert_buffer_size = 64M
myisam_recover_options = BACKUP
key_buffer_size = 32M          # MyISAM 使用，如有则保留
skip_external_locking

# MySQL 8.0 默认开启的参数
innodb_undo_tablespaces = 2
innodb_undo_log_truncate = ON
innodb_max_undo_log_size = 1G

# 严格模式（8.0 推荐）
gtid_mode = ON
enforce_gtid_consistency = ON

[mysqldump]
quick
max_allowed_packet = 256M

[mysqld_safe]
socket = /tmp/mysql.sock
nice = 0
log-error = /var/log/mysql/error.log