# ==================== 容器编排必需项 ====================
TZ=Asia/Shanghai

# 宿主机端口映射
DB_PORT=3306
REDIS_PORT=6379
NGINX_PORT=80

# ==================== 敏感配置（禁止提交到 git） ====================
# 使用方式：复制本文件为 .env（Windows: copy .env.example .env）
# 并将下方占位符替换为你的真实密钥

# MySQL
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD

# Redis
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# 邮件（163/QQ 邮箱使用"客户端授权码"）
MAIL_USERNAME=YOUR_MAIL_ACCOUNT
MAIL_PASSWORD=YOUR_MAIL_AUTH_CODE

# DeepSeek（https://platform.deepseek.com 获取）
SPRING_AI_OPENAI_API_KEY=YOUR_DEEPSEEK_API_KEY

# 阿里云智能语音交互
ALIYUN_NLS_APP_KEY=YOUR_NLS_APP_KEY
ALIYUN_NLS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
ALIYUN_NLS_ACCESS_KEY_SECRET=YOUR_ACCESS_KEY_SECRET
