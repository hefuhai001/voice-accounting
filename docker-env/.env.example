# ==================== 应用基础配置 ====================
APP_NAME=voice-accounting
TZ=Asia/Shanghai

# ==================== 服务端配置 ====================
SERVER_PORT=8080

# ==================== MySQL 配置 ====================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=db_voice_accounting
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD

# ==================== Redis 配置 ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD
REDIS_DATABASE=0

# ==================== 邮件服务配置 ====================
MAIL_HOST=smtp.163.com
MAIL_PORT=994
MAIL_USERNAME=YOUR_MAIL_ACCOUNT
MAIL_PASSWORD=YOUR_MAIL_AUTH_CODE

# ==================== DeepSeek 配置 ====================
SPRING_AI_OPENAI_API_KEY=YOUR_DEEPSEEK_API_KEY

# ==================== 阿里云智能语音交互配置 ====================
ALIYUN_NLS_APP_KEY=YOUR_NLS_APP_KEY
ALIYUN_NLS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
ALIYUN_NLS_ACCESS_KEY_SECRET=YOUR_ACCESS_KEY_SECRET

# ==================== Sa-Token 配置 ====================
# token 有效期（单位：秒），默认 2 小时
SA_TOKEN_TIMEOUT=7200

# ==================== Nginx 前端配置 ====================
NGINX_PORT=80
